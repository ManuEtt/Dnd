# Local demo. Generate secrets locally; never upload .env.
HOST=127.0.0.1
PORT=3000
AI_PROVIDER=mock
# Required for POST /v1/session. Generate: openssl rand -hex 32
LOCAL_ACCESS_TOKEN=
# Optional persistent signing secret. Empty: new random secret each restart.
SESSION_SECRET=
SESSION_TTL_SECONDS=300
REQUESTS_PER_MINUTE=15
REQUESTS_PER_DAY=100
# Remote hosting requires PUBLIC_ORIGIN=https://your-domain.example
PUBLIC_ORIGIN=
# Paid API calls require explicit opt-in, a server-only key and a chosen model.
ALLOW_PAID_AI=false
OPENAI_API_KEY=
OPENAI_MODEL=
